# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hitl
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# VibeProxy (OpenAI-compatible API for Claude, Gemini, etc.)
# Local proxy at http://localhost:8318 provides access to:
# - Antigravity (Claude Opus/Sonnet via Google account) - FREE
# - Gemini models
# - And more
VIBEPROXY_BASE_URL=http://localhost:8318/v1
VIBEPROXY_API_KEY=sk-vibeproxy-dummy

# Model configuration
# Execution: sonnet for reliable task completion
VIBEPROXY_EXECUTION_MODEL=gemini-claude-sonnet-4-5-thinking
# Classification: flash for fast tier classification
VIBEPROXY_CLASSIFICATION_MODEL=gemini-2.5-flash
# Reasoning: opus for complex decisions
VIBEPROXY_REASONING_MODEL=gemini-claude-opus-4-5-thinking

# Tier Thresholds
T0_CONFIDENCE_THRESHOLD=0.99
T1_CONFIDENCE_THRESHOLD=0.85
T2_CONFIDENCE_THRESHOLD=0.7
DEFAULT_RISK_THRESHOLD=0.5

# Escalation
ESCALATION_DEFAULT_SLA_MINUTES=60
ESCALATION_MAX_TIME_MINUTES=240
ESCALATION_REMINDER_INTERVALS=15,30,60,120
ESCALATION_AUTO_EXPIRE=true

# Observability
OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_ENABLED=true
LOG_LEVEL=info

# Server
PORT=3000
HOST=0.0.0.0
